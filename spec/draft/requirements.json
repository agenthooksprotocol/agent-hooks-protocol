      "anchor": "AHP-DEC-003",
      "section": "12.3 No `allow` effect",
      "profile": "tool-interception",
      "text": "An empty effect list is not an authorization grant and does not bypass harness permissions, sandboxing, or approval.",
      "textSha256": "358a67acc4e87deb921386d04e7eb1517b0f2cfba915c3f7bb59ce651debb2d7"
    },
