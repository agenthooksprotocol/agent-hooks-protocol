    "config.change.before": {
      "allOf": [
        {
          "type": "object",
          "required": [
            "id",
            "source",
            "time",
            "type"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "type": "string",
              "format": "uri"
            },
            "time": {
              "type": "string",
              "format": "date-time"
            },
