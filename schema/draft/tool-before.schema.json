{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenthooksprotocol.org/schemas/0.1.0-draft.1/tool-before.schema.json",
  "title": "AHP tool.before Event (Working Draft)",
  "$comment": "Working Draft 0.1.0-draft.1. Unknown object fields remain permitted by the protocol.",
  "x-requirements": ["AHP-TB-001", "AHP-CORE-003", "AHP-CORE-004"],
  "type": "object",
  "required": ["id", "source", "type", "time", "session", "tool"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "source": {"type": "string", "format": "uri"},
    "type": {"const": "tool.before"},
    "time": {"type": "string", "format": "date-time"},
    "session": {"$ref": "common.schema.json#/$defs/session"},
    "tool": {
      "type": "object",
      "required": ["callId", "name", "kind", "input"],
      "properties": {
        "callId": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "kind": {
          "enum": ["shell", "file_read", "file_write", "file_edit", "search", "fetch", "task", "mcp", "other"]
        },
        "input": {"type": "object"},
        "mcp": {"type": "object"}
      },
      "not": {
        "anyOf": [
          {"required": ["output"]},
          {"required": ["error"]}
        ]
      }
    },
    "native": {"$ref": "common.schema.json#/$defs/native"},
    "extensions": {"$ref": "extensions.schema.json"}
  }
}
