{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenthooksprotocol.org/schemas/draft/deny-effect.schema.json",
  "title": "AHP deny Effect (Draft)",
  "$comment": "Mutable AHP draft.",
  "x-requirements": ["AHP-CAP-001", "AHP-DEC-001", "AHP-DEC-002"],
  "type": "object",
  "required": ["type", "reason"],
  "properties": {
    "type": {"const": "deny"},
    "reason": {"type": "string", "minLength": 1},
    "code": {"type": "string", "pattern": "^(?:[A-Za-z][A-Za-z0-9_-]*\\.)+[A-Za-z][A-Za-z0-9_-]*$"},
    "extensions": {"$ref": "extensions.schema.json"}
  }
}
