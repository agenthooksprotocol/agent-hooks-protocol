use ahp_codegen::capability::{self as c, HostCapabilities, Modify};
use ahp_codegen::EventType;
use serde_json::{json, to_value};
use std::collections::BTreeMap;

#[test]
fn event_specific_immutable_declarations_and_explicit_observation() {
    let base = c::tool_before().deny();
    let modified = base.modify_input(Modify::Replace);
    assert_eq!(to_value(&base).unwrap(), json!({"modes":["intercept"],"capabilities":{"effects":["deny"]}}));
    assert_eq!(to_value(&modified).unwrap(), json!({"modes":["intercept"],"capabilities":{"effects":["deny","modify"],"modify":{"input":{"replace":true,"merge":false}}}}));
    let composed = modified.modify_input(Modify::Merge).allow().return_result().observe();
    let wire = to_value(&composed).unwrap();
    assert_eq!(wire["modes"], json!(["intercept", "observe"]));
    assert_eq!(wire["capabilities"]["modify"]["input"], json!({"replace":true,"merge":true}));
    assert_eq!(to_value(c::tool_before().observe()).unwrap(), json!({"modes":["observe"]}));
    assert_eq!(to_value(c::tool_before().observe().deny()).unwrap()["modes"], json!(["intercept", "observe"]));
    let host = HostCapabilities {tool_before: Some(composed), ..Default::default()};
    let declarations: BTreeMap<EventType, c::WireDeclaration> = host.to_wire();
    assert_eq!(declarations.len(), 1);
    assert_eq!(to_value(&declarations[&EventType::ToolBefore]).unwrap(), wire);
    assert_eq!(to_value(&declarations).unwrap(), json!({"tool.before": wire}));
    assert!(HostCapabilities::default().to_wire().is_empty());
}

#[test]
fn dependent_grants_are_nonempty_and_counts_are_required() {
    let controlled = c::tool_after()
        .flow(c::Flow::StopAndContinue {remaining_continuations: 2, continuation_count: 0, max_continuations: Some(u64::MAX)})
        .flow(c::Flow::Stop)
        .inject_context(c::InjectContext::Now).inject_context(c::InjectContext::NextTurn)
        .elicitation_form().elicitation_url();
    let wire = to_value(controlled).unwrap();
    assert_eq!(wire["modes"], json!(["intercept"]));
    assert_eq!(wire["capabilities"]["flow"], json!({"operations":["stop","continue"],"remainingContinuations":2,"continuationCount":0,"maxContinuations":u64::MAX}));
    assert_eq!(wire["capabilities"]["inject"], json!({"context":{"append":true,"deliverAt":["now","next_turn"]}}));
    assert_eq!(wire["capabilities"]["elicitation"], json!({"form":{},"url":{}}));
    assert_eq!(to_value(c::tool_before().flow(c::ToolBeforeFlow::Stop)).unwrap()["capabilities"]["flow"], json!({"operations":["stop"]}));
    // Selecting a facility explicitly activates interception without adding effects.
    assert_eq!(to_value(c::tool_before().observe().elicitation_form()).unwrap(), json!({"modes":["intercept","observe"],"capabilities":{"effects":[],"elicitation":{"form":{}}}}));
    let host = HostCapabilities {tool_progress: Some(c::Observe), ..Default::default()};
    assert_eq!(to_value(host.to_wire()).unwrap(), json!({"tool.progress":{"modes":["observe"]}}));
}

#[test]
fn first_facility_is_installable_and_uses_canonical_empty_effects() {
    let form = c::user_elicitation_request().elicitation_form();
    let expected = json!({"modes":["intercept"],"capabilities":{"effects":[],"elicitation":{"form":{}}}});
    assert_eq!(to_value(&form).unwrap(), expected);
    assert_eq!(to_value(c::tool_before().elicitation_form()).unwrap(), expected);
    let url = c::tool_after().elicitation_url();
    assert_eq!(to_value(&url).unwrap(), json!({"modes":["intercept"],"capabilities":{"effects":[],"elicitation":{"url":{}}}}));
    assert_eq!(to_value(c::user_elicitation_request().elicitation_url()).unwrap(), to_value(&url).unwrap());
    let both = form.elicitation_url();
    assert_eq!(to_value(&form).unwrap(), expected);
    assert_eq!(to_value(&both).unwrap()["capabilities"]["elicitation"], json!({"form":{},"url":{}}));
    let host = HostCapabilities {
        user_elicitation_request: Some(form),
        tool_after: Some(url),
        ..Default::default()
    };
    let wire = to_value(host.to_wire()).unwrap();
    assert_eq!(wire["user.elicitation.request"], expected);
    assert_eq!(wire["tool.after"]["capabilities"]["effects"], json!([]));
    let grants = wire["user.elicitation.request"]["capabilities"].clone();
    let scoped: ahp_codegen::UserElicitationRequestCapabilities = serde_json::from_value(grants.clone()).unwrap();
    assert_eq!(to_value(scoped).unwrap(), grants);
    match ahp_codegen::parse_capabilities_value(grants.clone()) {
        ahp_codegen::ParseResult::Success { value, raw, .. } => {
            assert_eq!(raw, grants);
            assert_eq!(to_value(value).unwrap(), grants);
        }
        ahp_codegen::ParseResult::Failure { diagnostics, .. } => panic!("facility-only canonical capabilities rejected: {diagnostics:?}"),
    }
}
