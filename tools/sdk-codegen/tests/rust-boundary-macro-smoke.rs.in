#[cfg(test)]
pub struct CompleteHooks;
#[cfg(test)]
impl CompleteHooks {
    fn event_for<T>(&self, name: EventType, event: T) -> hooks::EventBoundary<'_, T> {
        hooks::EventBoundary {name, event, marker: std::marker::PhantomData}
    }
    crate::generated::ahp_hooks_boundary_methods!();
}
#[cfg(test)]
const NAMED_BOUNDARIES: &[EventType] = crate::generated::ahp_hooks_boundary_methods!(inventory);
#[test]
fn native_complete_event_macros_and_inventory_use_the_public_enum() {
    assert_eq!(NAMED_BOUNDARIES.len(), 32);
    let typed_names: std::collections::BTreeSet<_> = NAMED_BOUNDARIES.iter().map(|event| event.as_str()).collect();
    let wire_names: std::collections::BTreeSet<_> = generated::boundary::ALL_BOUNDARIES.iter().map(|event| event.name).collect();
    assert_eq!(typed_names, wire_names);
    let client = TypedClient;
    let hooks = CompleteHooks;
    let call = client.tool_before_event(7u8);
    assert_eq!(call.name, EventType::ToolBefore);
    assert_eq!(call.event, 7);
    let call = hooks.session_end(8u8);
    assert_eq!(call.name, EventType::SessionEnd);
    assert_eq!(call.event, 8);
}
